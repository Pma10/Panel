# Copy to .env (mode 0600) for compose.yaml. Never commit it.
# The admin UI must sit behind an HTTPS reverse proxy at this exact origin.
PANEL_PUBLIC_ORIGIN=https://panel.example.com
# Creates the first account, "admin", on the first start (12+ characters).
# A panel reachable from other machines refuses to start without an account.
PANEL_ADMIN_PASSWORD=CHANGE_ME_TO_A_RANDOM_PASSWORD_20_PLUS_CHARACTERS
